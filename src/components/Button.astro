---
export interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'inverse';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className = '' } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element href={href} class={`button button-${variant} ${className}`}>
  <slot />
</Element>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.20;
    border-radius: var(--rounded-md);
    padding: 8px 14px;
    cursor: pointer;
    border: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .button-primary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .button-primary:hover {
    background-color: var(--color-primary-hover);
  }
  .button-primary:active {
    background-color: var(--color-primary-focus);
  }

  .button-secondary {
    background-color: var(--color-surface-1);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
  }

  .button-tertiary {
    background-color: var(--color-canvas);
    color: var(--color-ink);
  }

  .button-inverse {
    background-color: var(--color-inverse-canvas);
    color: var(--color-inverse-ink);
  }
</style>
